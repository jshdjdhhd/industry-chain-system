### ==================== 节点管理（在固定阶段下创建细分节点）====================

### 5. 在上游阶段下添加细分节点（捕获 id 到 n1）
POST http://localhost:8080/api/chains/{{chainId}}/nodes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "parentId": {{upstreamStageId}},
  "nodeName": "原材料端",
  "sortOrder": 1
}

> {%
    client.global.set("n1", response.body.data.id);
%}

### 6. 在 n1 下添加子节点（捕获 id 到 n2）
POST http://localhost:8080/api/chains/{{chainId}}/nodes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "parentId": {{n1}},
  "nodeName": "原材料",
  "sortOrder": 1
}

> {%
    client.global.set("n2", response.body.data.id);
%}

### 7. 在中游阶段下添加细分节点（捕获 id 到 n4）
POST http://localhost:8080/api/chains/{{chainId}}/nodes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "parentId": {{midstreamStageId}},
  "nodeName": "制造端",
  "sortOrder": 2
}

> {%
    client.global.set("n4", response.body.data.id);
%}

### 创建同级移动回归节点 A
POST http://localhost:8080/api/chains/{{chainId}}/nodes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "parentId": null,
  "nodeName": "同级移动回归-A",
  "sortOrder": 90
}

> {%
    client.global.set("siblingMoveA", response.body.data.id);
%}

### 创建同级移动回归节点 B
POST http://localhost:8080/api/chains/{{chainId}}/nodes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "parentId": null,
  "nodeName": "同级移动回归-B",
  "sortOrder": 91
}

> {%
    client.global.set("siblingMoveB", response.body.data.id);
%}

### 将一级节点 A 移动到同级节点 B 下
PUT http://localhost:8080/api/chains/nodes/{{siblingMoveA}}/move
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newParentId": {{siblingMoveB}},
  "sortOrder": 0
}

> {%
    client.test("同级节点可以成为新的父节点", function () {
        client.assert(response.status === 200);
        client.assert(
            response.body.data.parentId
                === Number(client.global.get("siblingMoveB")));
        client.assert(response.body.data.nodeLevel === 2);
    });
%}

### 移动后查询产业链树，确认 A 位于 B 的 children 中
GET http://localhost:8080/api/chains/{{chainId}}/tree
Authorization: Bearer {{token}}

> {%
    const siblingMoveA = String(client.global.get("siblingMoveA"));
    const siblingMoveB = String(client.global.get("siblingMoveB"));
    const parent = response.body.data.children.find(
        node => String(node.id) === siblingMoveB
    );
    client.assert(parent !== undefined, "树中应存在同级移动回归节点 B");
    client.assert(
        parent.children.some(node => String(node.id) === siblingMoveA),
        "同级移动回归节点 A 应位于 B 的 children 中"
    );
%}

### 清理同级移动回归节点 A
DELETE http://localhost:8080/api/chains/nodes/{{siblingMoveA}}
Authorization: Bearer {{token}}

### 清理同级移动回归节点 B
DELETE http://localhost:8080/api/chains/nodes/{{siblingMoveB}}
Authorization: Bearer {{token}}

