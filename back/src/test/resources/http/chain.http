### 该文件为测试脚本，用于测试项目功能是否正常

### 0.0 记录本次测试开始时间（用于最后清理 operation_log）
GET http://localhost:8080/api/health

> {%
    function pad(value) {
        return value.toString().padStart(2, "0");
    }
    const now = new Date();
    const localDateTime =
        now.getFullYear() + "-" +
        pad(now.getMonth() + 1) + "-" +
        pad(now.getDate()) + "T" +
        pad(now.getHours()) + ":" +
        pad(now.getMinutes()) + ":" +
        pad(now.getSeconds());
    client.global.set("chainHttpStartedAt", localDateTime);
%}

### 0. 登录拿 token（admin / admin123）
# 返回体 data.token 存到全局变量 {{token}}，后续请求带 Authorization: Bearer {{token}}
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    client.global.set("token", response.body.data.token);
%}

### 0.1 不带 token 访问受保护接口（应返回 401）
GET http://localhost:8080/api/chains


### ==================== 产业链管理（全程用新建的链，不碰演示数据）====================

### 1. 创建产业链（捕获返回的 id 到 chainId）
POST http://localhost:8080/api/chains
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "chainName": "测试临时产业链-请删除",
  "description": "chain.http 自动化测试用，测完即删"
}

> {%
    client.assert(response.status === 200);
    client.assert(response.body.data.nodeCount === 3);
    client.global.set("chainId", response.body.data.id);
%}

### 1.1 查询新链的三个固定阶段节点
GET http://localhost:8080/api/chains/{{chainId}}/tree
Authorization: Bearer {{token}}

> {%
    client.test("新链包含三个阶段节点", function () {
        const nodes = response.body.data.children;
        client.assert(nodes.length === 3);
        client.assert(nodes[0].stageType === "UPSTREAM");
        client.assert(nodes[1].stageType === "MIDSTREAM");
        client.assert(nodes[2].stageType === "DOWNSTREAM");
        client.global.set("upstreamStageId", nodes[0].id);
        client.global.set("midstreamStageId", nodes[1].id);
        client.global.set("downstreamStageId", nodes[2].id);
    });
%}

### 1.2 固定阶段节点禁止移动
PUT http://localhost:8080/api/chains/nodes/{{upstreamStageId}}/move
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newParentId": null
}

> {%
    client.assert(response.status === 400);
    client.assert(response.body.message === "阶段节点无法修改父节点");
%}

### 1.3 固定阶段节点禁止单独删除
DELETE http://localhost:8080/api/chains/nodes/{{upstreamStageId}}
Authorization: Bearer {{token}}

> {%
    client.assert(response.status === 400);
    client.assert(response.body.message === "上下游阶段节点不允许删除");
%}

