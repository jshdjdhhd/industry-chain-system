    { "nodeId": {{upstreamStageId}}, "sortOrder": 1 },
    { "nodeId": {{midstreamStageId}}, "sortOrder": 2 },
    { "nodeId": {{downstreamStageId}}, "sortOrder": 3 }
  ]
}

