<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="git.ggwzz.auth.mapper.SysPermissionMapper">

    <resultMap id="sysPermissionMap" type="git.ggwzz.auth.entity.SysPermission">
        <id column="id" property="id"/>
        <result column="permission_code" property="permissionCode"/>
        <result column="permission_name" property="permissionName"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort" property="sort"/>
        <result column="deleted" property="deleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByUserId" resultMap="sysPermissionMap">
        SELECT DISTINCT p.id, p.permission_code, p.permission_name, p.parent_id, p.sort, p.deleted, p.created_at, p.updated_at
        FROM sys_permission p
        INNER JOIN sys_role_permission rp ON rp.permission_id = p.id
        INNER JOIN sys_user_role ur ON ur.role_id = rp.role_id
        WHERE ur.user_id = #{userId}
          AND p.deleted = 0
        ORDER BY p.sort ASC, p.id ASC
    </select>

</mapper>