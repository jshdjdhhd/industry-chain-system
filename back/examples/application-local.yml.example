# 本地配置示例
# 复制本文件到 src/main/resources/application-local.yml 并按实际填写真实值。
# application-local.yml 已在 .gitignore 中，不会被提交。
# 启动时通过 -Dspring.profiles.active=local,dev 叠加，或直接覆盖 dev 的占位默认值。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/industry_chain?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: your-real-password

security:
  jwt:
    secret: your-local-strong-random-secret-at-least-32-bytes-long
    expiration: 7200
  cors:
    allowed-origins:
      - http://localhost:5173

matching:
  llm:
    # 小米 MiMo OpenAI-compatible 接口；测试 Key 也不要提交到 Git。
    provider: mimo
    base-url: https://api.xiaomimimo.com/v1
    model: mimo-v2.5-pro
    api-key: ${MATCHING_LLM_API_KEY:}
    candidate-top-k: 10
    result-top-k: 5
  embedding:
    # 本地 Ollama + Qwen3 Embedding 推理服务，使用 OpenAI-compatible /v1/embeddings 接口。
    endpoint: http://localhost:11434/v1/embeddings
    model: qwen3-embedding:0.6b
    api-key:
    dimension: 1024
