# 产业链管理系统后端环境变量样例
# 复制为 .env（不提交 Git）并按实际填写，启动前需将这些变量导入当前终端。

# Spring 激活环境：dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# 数据库连接（dev 已有本地默认值，可不动；test/prod 必须提供）
DB_URL=jdbc:mysql://localhost:3306/industry_chain?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT 密钥（生产必须使用高强度随机串，至少 32 字节；禁止提交真实值到 Git）
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes-long

# 服务端口
SERVER_PORT=8080

# 允许的前端地址（CORS），test/prod 必须提供
CORS_ORIGIN=http://localhost:5173

# 智能挂链 V3 大模型配置。测试 Key 也不要写入 Git，联调用环境变量注入。
MATCHING_LLM_PROVIDER=mimo
MATCHING_LLM_BASE_URL=https://api.xiaomimimo.com/v1
MATCHING_LLM_MODEL=mimo-v2.5-pro-ultraspeed
MATCHING_LLM_API_KEY=
MATCHING_LLM_CANDIDATE_TOP_K=10
MATCHING_LLM_RESULT_TOP_K=5
